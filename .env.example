# Server-side Google Gen AI credentials and model selection
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=dwelld

# YOLO object detection runs in the browser; no detector API credential is needed.

# Profile authentication: generate a random 32+ character secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Verifier confidence (0-1) at or above which AI damage findings are approved without a person
AUTO_APPROVE_THRESHOLD=0.85
# Optional: a different model for the verification pass (defaults to GEMINI_MODEL)
# GEMINI_VERIFY_MODEL=gemini-4-argon
